        item.innerHTML = `
          <span class="city-name font-medium">${city.name}</span>
          <span class="text-xs text-stone-400 font-mono">${city.lat.toFixed(1)}°, ${city.lng.toFixed(1)}°</span>
        `;
        item.addEventListener('click', () => {
          state.locationName = city.name;
          state.lat = city.lat;
          state.lng = city.lng;
          if (city.method) state.method = city.method;
          if (city.asr) state.asrSchool = city.asr;
          
          document.getElementById('setting-method').value = state.method;
          document.getElementById('setting-asr-school').value = state.asrSchool;

          updateAll();
          renderMonthlyTimetable(state.selectedMonthOffset);
          closeLocationModal();
          showToast(`Location set to ${city.name}`, 'fa-map-pin');
        });
        container.appendChild(item);
      });
    }

    function filterCities(searchQuery) {
      const q = searchQuery.toLowerCase().trim();
      const items = document.querySelectorAll('#popular-cities-list .city-item');
      items.forEach(el => {
        const name = el.querySelector('.city-name').textContent.toLowerCase();
        if (name.includes(q)) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
    }

    // ==========================================
    // GEOLOCATION (NAVIGATOR.GEOLOCATION)
    // ==========================================
    function detectUserLocation() {
      if (!navigator.geolocation) {
        showToast("Geolocation is not supported by your browser.", "fa-triangle-exclamation");
        return;
      }

      showToast("Accessing device GPS...", "fa-satellite");

      navigator.geolocation.getCurrentPosition(
        (position) => {
          state.lat = position.coords.latitude;
          state.lng = position.coords.longitude;
          state.locationName = `Custom Location (${state.lat.toFixed(2)}°, ${state.lng.toFixed(2)}°)`;

          // Reverse geocode fallback query using open reverse geocoding API if available
          fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${state.lat}&lon=${state.lng}&zoom=10`)
            .then(res => res.json())
            .then(data => {
              if (data && data.address) {
                const city = data.address.city || data.address.town || data.address.state || "Detected Area";
                const country = data.address.country || "";
                state.locationName = `${city}, ${country}`;
                updateAll();
              }
            })
            .catch(() => {
              // Graceful fallback to coords name
            })
            .finally(() => {
              updateAll();
              renderMonthlyTimetable(state.selectedMonthOffset);
              closeLocationModal();
              showToast("Location updated successfully via GPS!", "fa-circle-check");
            });
        },
        (error) => {
          showToast("Unable to retrieve location. Please choose a city.", "fa-circle-xmark");
        },
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 60000 }
      );
    }

    // ==========================================
    // DEVICE ORIENTATION COMPASS LISTENER
    // ==========================================
    let orientationActive = false;
    function requestOrientationPermission() {
      // iOS 13+ requires explicit permission request
      if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
        DeviceOrientationEvent.requestPermission()
          .then(permissionState => {
            if (permissionState === 'granted') {
              startOrientationListener();
            } else {
              showToast("Compass orientation permission denied", "fa-triangle-exclamation");
            }
          })
          .catch(console.error);
      } else {
        // Standard Android / Desktop modern browsers
        startOrientationListener();
      }
    }

    function startOrientationListener() {
      if (orientationActive) return;

      window.addEventListener('deviceorientationabsolute', handleOrientation, true);
      window.addEventListener('deviceorientation', handleOrientation, true);
      orientationActive = true;
      showToast("Live Device Compass Active! Rotate your phone horizontally.", "fa-compass");
    }

    function handleOrientation(event) {
      let compassHeading = null;

      // Webkit iOS proprietary compass heading
      if (event.webkitCompassHeading) {
        compassHeading = event.webkitCompassHeading;
      } else if (event.alpha !== null) {
        // Standard compass heading (Android / modern Chrome)
        compassHeading = 360 - event.alpha;
      }

      if (compassHeading !== null) {
        state.currentHeading = compassHeading;
        document.getElementById('heading-slider').value = Math.round(compassHeading);
        document.getElementById('manual-heading-val').textContent = `${Math.round(compassHeading)}°`;
        const qiblaData = calculateQibla(state.lat, state.lng);
        updateCompassVisual(qiblaData.bearing);
      }
    }

    // ==========================================
    // MODALS & NAVIGATION LOGIC
    // ==========================================
    const locationModal = document.getElementById('location-modal');
    const settingsModal = document.getElementById('settings-modal');

    function openLocationModal() {
      locationModal.classList.remove('hidden');
      setTimeout(() => locationModal.classList.remove('opacity-0'), 10);
    }
    function closeLocationModal() {
      locationModal.classList.add('opacity-0');
      setTimeout(() => locationModal.classList.add('hidden'), 200);
    }

    function openSettingsModal() {
      // Sync inputs with state
      document.getElementById('setting-method').value = state.method;
      document.getElementById('setting-asr-school').value = state.asrSchool;
      document.getElementById('setting-time-format').value = state.timeFormat;
      document.getElementById('offset-fajr').value = state.offsetFajr;
      document.getElementById('offset-maghrib').value = state.offsetMaghrib;

      settingsModal.classList.remove('hidden');
      setTimeout(() => settingsModal.classList.remove('opacity-0'), 10);
    }
    function closeSettingsModal() {
      settingsModal.classList.add('opacity-0');
      setTimeout(() => settingsModal.classList.add('hidden'), 200);
    }

    // ==========================================
    // EVENT LISTENERS INITIALIZATION
    // ==========================================
    window.addEventListener('DOMContentLoaded', () => {
      // 1. Navigation Tab Switching
      const tabs = document.querySelectorAll('.nav-tab');
      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(t => {
            t.classList.remove('active-tab', 'border-gold-500', 'text-gold-600', 'dark:text-gold-400', 'bg-gold-500/10', 'dark:bg-emerald-900/50');
            t.classList.add('border-transparent', 'text-stone-500', 'dark:text-stone-400');
          });
          tab.classList.add('active-tab', 'border-gold-500', 'text-gold-600', 'dark:text-gold-400', 'bg-gold-500/10', 'dark:bg-emerald-900/50');
          tab.classList.remove('border-transparent', 'text-stone-500', 'dark:text-stone-400');

          const targetId = tab.getAttribute('data-target');
          document.querySelectorAll('.tab-content').forEach(content => {
            if (content.id === targetId) {
              content.classList.remove('hidden');
            } else {
              content.classList.add('hidden');
            }
          });

          // Refresh monthly timetable if that tab is chosen
          if (targetId === 'tab-timetable') {
            renderMonthlyTimetable(state.selectedMonthOffset);
          }
        });
      });

      // 2. Theme Toggle (Dark / Light)
      const themeBtn = document.getElementById('theme-toggle-btn');
      const themeIcon = document.getElementById('theme-icon');
      themeBtn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        if (isDark) {
          themeIcon.className = "fa-solid fa-sun text-base text-gold-500";
        } else {
          themeIcon.className = "fa-solid fa-moon text-base text-emerald-800";
        }
      });

      // 3. Audio Notification Toggle
      const audioBtn = document.getElementById('audio-toggle-btn');
      const audioIcon = document.getElementById('audio-icon');
      audioBtn.addEventListener('click', () => {
        state.audioEnabled = !state.audioEnabled;
        if (state.audioEnabled) {
          audioIcon.className = 'fa-solid fa-volume-high text-base';
          showToast('Audio notifications enabled', 'fa-volume-high');
        } else {
          audioIcon.className = 'fa-solid fa-volume-xmark text-base';
          showToast('Audio notifications muted', 'fa-volume-xmark');
        }
      });

      document.getElementById('btn-quick-adhan-sample').addEventListener('click', () => {
        playAdhanNotificationChime();
      });

      // 4. Modals Triggers
      document.getElementById('location-modal-btn').addEventListener('click', openLocationModal);
      document.getElementById('close-location-modal').addEventListener('click', closeLocationModal);
      locationModal.addEventListener('click', (e) => {
        if (e.target === locationModal) closeLocationModal();
      });

      document.getElementById('settings-modal-btn').addEventListener('click', openSettingsModal);
      document.getElementById('close-settings-modal').addEventListener('click', closeSettingsModal);
      settingsModal.addEventListener('click', (e) => {
        if (e.target === settingsModal) closeSettingsModal();
      });

      // 5. GPS Detect Button
      document.getElementById('btn-detect-gps').addEventListener('click', detectUserLocation);

      // 6. Cities Search Filter
      initPopularCities();
      document.getElementById('city-search-input').addEventListener('input', (e) => {
        filterCities(e.target.value);
      });

      // 7. Custom Coordinates Apply
      document.getElementById('btn-apply-custom-coords').addEventListener('click', () => {
        const latVal = parseFloat(document.getElementById('custom-lat').value);
        const lngVal = parseFloat(document.getElementById('custom-lng').value);

        if (isNaN(latVal) || isNaN(lngVal) || latVal < -90 || latVal > 90 || lngVal < -180 || lngVal > 180) {
          showToast('Please enter valid latitude (-90 to 90) and longitude (-180 to 180).', 'fa-triangle-exclamation');
          return;
        }

        state.lat = latVal;
        state.lng = lngVal;
        state.locationName = `Custom (${latVal.toFixed(2)}°, ${lngVal.toFixed(2)}°)`;
        updateAll();
        renderMonthlyTimetable(state.selectedMonthOffset);
        closeLocationModal();
        showToast('Custom coordinates applied', 'fa-circle-check');
      });

      // 8. Save Settings
      document.getElementById('btn-save-settings').addEventListener('click', () => {
        state.method = document.getElementById('setting-method').value;
        state.asrSchool = document.getElementById('setting-asr-school').value;
        state.timeFormat = document.getElementById('setting-time-format').value;
        state.offsetFajr = parseInt(document.getElementById('offset-fajr').value) || 0;
        state.offsetMaghrib = parseInt(document.getElementById('offset-maghrib').value) || 0;

        closeSettingsModal();
        updateAll();
        renderMonthlyTimetable(state.selectedMonthOffset);
        showToast('Settings saved successfully', 'fa-circle-check');
      });

      // 9. Qibla Manual Heading Slider (Testing & Desktop Calibration)
      const headingSlider = document.getElementById('heading-slider');
      headingSlider.addEventListener('input', (e) => {
        state.currentHeading = parseFloat(e.target.value);
        document.getElementById('manual-heading-val').textContent = `${Math.round(state.currentHeading)}°`;
        const qiblaData = calculateQibla(state.lat, state.lng);
        updateCompassVisual(qiblaData.bearing);
      });

      document.getElementById('btn-reset-heading').addEventListener('click', () => {
        state.currentHeading = 0;
        headingSlider.value = 0;
        document.getElementById('manual-heading-val').textContent = '0° (North)';
        const qiblaData = calculateQibla(state.lat, state.lng);
        updateCompassVisual(qiblaData.bearing);
      });

      document.getElementById('btn-calibrate-compass').addEventListener('click', requestOrientationPermission);

      // 10. Digital Tasbih Buttons
      document.getElementById('tasbih-counter-button').addEventListener('click', incrementTasbih);
      document.getElementById('tasbih-reset-btn').addEventListener('click', resetTasbih);
      
      document.getElementById('tasbih-target-33').addEventListener('click', () => {
        state.tasbihTarget = 33;
        updateTasbihUI();
      });
      document.getElementById('tasbih-target-99').addEventListener('click', () => {
        state.tasbihTarget = 99;
        updateTasbihUI();
      });
      document.getElementById('tasbih-target-100').addEventListener('click', () => {
        state.tasbihTarget = 100;
        updateTasbihUI();
      });

      // Tasbih Phrase Select Change
      document.getElementById('tasbih-phrase-select').addEventListener('change', (e) => {
        const parts = e.target.value.split('|');
        document.getElementById('tasbih-arabic-display').textContent = parts[1];
        document.getElementById('tasbih-english-display').textContent = `"${parts[2]}"`;
      });

      // 11. Ayat of the Day Refresh & Copy
      let ayatIndex = 0;
      function setAyat(idx) {
        const item = AYAT_COLLECTION[idx % AYAT_COLLECTION.length];
        document.getElementById('daily-ayat-arabic').textContent = item.arabic;
        document.getElementById('daily-ayat-translation').textContent = `"${item.translation}"`;
        document.getElementById('daily-ayat-ref').textContent = item.ref;
      }

      document.getElementById('refresh-ayat-btn').addEventListener('click', () => {
        ayatIndex++;
        setAyat(ayatIndex);
      });

      document.getElementById('copy-ayat-btn').addEventListener('click', () => {
        const item = AYAT_COLLECTION[ayatIndex % AYAT_COLLECTION.length];
        const textToCopy = `${item.arabic}\n"${item.translation}"\n- ${item.ref}`;
        
        // Execute copy with fallback
        const textArea = document.createElement("textarea");
        textArea.value = textToCopy;
        document.body.appendChild(textArea);
        textArea.select();
        try {
          document.execCommand('copy');
          showToast('Ayat copied to clipboard!', 'fa-copy');
        } catch (err) {
          showToast('Failed to copy text', 'fa-triangle-exclamation');
        }
        document.body.removeChild(textArea);
      });

      // 12. Monthly Timetable Navigation & Print
      document.getElementById('btn-month-prev').addEventListener('click', () => {
        state.selectedMonthOffset--;
        renderMonthlyTimetable(state.selectedMonthOffset);
      });
      document.getElementById('btn-month-next').addEventListener('click', () => {
        state.selectedMonthOffset++;
        renderMonthlyTimetable(state.selectedMonthOffset);
      });
      document.getElementById('btn-print-timetable').addEventListener('click', () => {
        window.print();
      });

      // 13. Initial Render & Live Clock Interval
      updateAll();
      renderMonthlyTimetable(state.selectedMonthOffset);
      updateTasbihUI();

      // Live 1-second interval update for clock and dynamic countdown
      setInterval(() => {
        updateAll();
      }, 1000);
    });
  </script>
</body>
</html>
