<!DOCTYPE html>
<html lang="en" class="dark">-
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Noor — Islamic Prayer Times & Qibla Finder</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            emerald: {
              850: '#06422b',
              900: '#063825',
              950: '#032317',
            },
            gold: {
              400: '#f5c968',
              500: '#e5b23a',
              600: '#ca9724',
              700: '#9b7012',
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            arabic: ['Amiri', 'Traditional Arabic', 'serif'],
          }
        }
      }
    }
  </script>

  <!-- Google Fonts for Typography & Arabic Script -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- FontAwesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    /* Islamic Geometric Pattern Subtle Overlays */
    .islamic-pattern {
      background-color: transparent;
      background-image: radial-gradient(rgba(229, 178, 58, 0.08) 1.5px, transparent 1.5px), radial-gradient(rgba(229, 178, 58, 0.08) 1.5px, transparent 1.5px);
      background-size: 28px 28px;
      background-position: 0 0, 14px 14px;
    }
    
    .gold-glow {
      box-shadow: 0 0 25px -3px rgba(229, 178, 58, 0.35);
    }
    
    .gold-gradient-text {
      background: linear-gradient(135deg, #fbe8a6 0%, #e5b23a 50%, #ca9724 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .compass-dial {
      transition: transform 0.2s cubic-bezier(0.25, 1, 0.5, 1);
      transform-origin: center center;
    }

    /* Print styling for monthly timetable */
    @media print {
      body * {
        visibility: hidden;
      }
      #print-section, #print-section * {
        visibility: visible;
      }
      #print-section {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
      }
      .no-print {
        display: none !important;
      }
    }

    /* Custom subtle scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.1);
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(229, 178, 58, 0.3);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(229, 178, 58, 0.6);
    }
  </style>
</head>
<body class="bg-stone-50 dark:bg-emerald-950 text-stone-800 dark:text-stone-100 min-h-screen transition-colors duration-300 font-sans islamic-pattern relative flex flex-col selection:bg-gold-500 selection:text-emerald-950">

  <!-- Top Notification Toast -->
  <div id="toast" class="fixed top-5 right-5 z-50 transform translate-y-[-120%] opacity-0 transition-all duration-300 pointer-events-none bg-emerald-900 border border-gold-500/40 text-stone-100 px-5 py-3.5 rounded-xl shadow-2xl flex items-center gap-3">
    <div id="toast-icon" class="text-gold-400 text-lg"><i class="fa-solid fa-circle-info"></i></div>
    <div id="toast-message" class="text-sm font-medium">Notification message</div>
  </div>

  <!-- Header / Navigation Bar -->
  <header class="sticky top-0 z-40 backdrop-blur-md bg-stone-100/85 dark:bg-emerald-950/85 border-b border-stone-200 dark:border-emerald-800/60 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- Brand Logo & Title -->
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-emerald-800 to-emerald-600 dark:from-emerald-900 dark:to-emerald-700 border border-gold-500/50 flex items-center justify-center shadow-md">
          <i class="fa-solid fa-mosque text-gold-400 text-xl"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-2xl font-bold tracking-tight gold-gradient-text">NOOR</span>
            <span class="text-xs uppercase tracking-widest font-semibold px-2 py-0.5 rounded-full bg-gold-500/10 text-gold-600 dark:text-gold-400 border border-gold-500/30">نُور</span>
          </div>
          <p class="text-xs text-stone-500 dark:text-stone-400">Prayer Times &amp; Qibla Sanctuary</p>
        </div>
      </div>

      <!-- Quick Location & Global Controls -->
      <div class="flex items-center gap-2 sm:gap-4">
        <!-- Live Current City Display -->
        <button id="location-modal-btn" class="flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-medium bg-stone-200/70 dark:bg-emerald-900/60 hover:bg-gold-500/10 border border-stone-300 dark:border-emerald-700/60 hover:border-gold-500/50 transition duration-200 text-stone-700 dark:text-stone-200">
          <i class="fa-solid fa-location-dot text-gold-500 text-sm"></i>
          <span id="current-location-text" class="max-w-[120px] sm:max-w-[200px] truncate font-semibold">Locating...</span>
          <i class="fa-solid fa-chevron-down text-xs opacity-60"></i>
        </button>

        <!-- Audio Preview & Toggle -->
        <button id="audio-toggle-btn" title="Toggle prayer sound alerts" class="p-2.5 rounded-xl text-stone-600 dark:text-stone-300 hover:text-gold-500 dark:hover:text-gold-400 bg-stone-200/50 dark:bg-emerald-900/40 hover:bg-gold-500/10 border border-stone-300 dark:border-emerald-800 transition">
          <i id="audio-icon" class="fa-solid fa-volume-high text-base"></i>
        </button>

        <!-- Settings Modal Trigger -->
        <button id="settings-modal-btn" title="Calculation Settings" class="p-2.5 rounded-xl text-stone-600 dark:text-stone-300 hover:text-gold-500 dark:hover:text-gold-400 bg-stone-200/50 dark:bg-emerald-900/40 hover:bg-gold-500/10 border border-stone-300 dark:border-emerald-800 transition">
          <i class="fa-solid fa-gear text-base"></i>
        </button>

        <!-- Dark / Light Mode Switch -->
        <button id="theme-toggle-btn" title="Toggle Theme" class="p-2.5 rounded-xl text-stone-600 dark:text-stone-300 hover:text-gold-500 dark:hover:text-gold-400 bg-stone-200/50 dark:bg-emerald-900/40 hover:bg-gold-500/10 border border-stone-300 dark:border-emerald-800 transition">
          <i id="theme-icon" class="fa-solid fa-sun text-base text-gold-500"></i>
        </button>
      </div>

    </div>
  </header>

  <!-- Navigation Tabs -->
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 mt-4 no-print">
    <nav class="flex space-x-2 border-b border-stone-200 dark:border-emerald-800/70 overflow-x-auto pb-1 scrollbar-none">
      <button class="nav-tab active-tab px-4 py-2.5 rounded-t-xl text-sm font-semibold flex items-center gap-2 border-b-2 border-gold-500 text-gold-600 dark:text-gold-400 bg-gold-500/10 dark:bg-emerald-900/50" data-target="tab-prayers">
        <i class="fa-solid fa-clock"></i> <span>Prayer Times</span>
      </button>
      <button class="nav-tab px-4 py-2.5 rounded-t-xl text-sm font-semibold flex items-center gap-2 border-b-2 border-transparent text-stone-500 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200 hover:bg-stone-200/40 dark:hover:bg-emerald-900/30 transition" data-target="tab-qibla">
        <i class="fa-solid fa-compass"></i> <span>Qibla Finder</span>
      </button>
      <button class="nav-tab px-4 py-2.5 rounded-t-xl text-sm font-semibold flex items-center gap-2 border-b-2 border-transparent text-stone-500 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200 hover:bg-stone-200/40 dark:hover:bg-emerald-900/30 transition" data-target="tab-timetable">
        <i class="fa-solid fa-calendar-days"></i> <span>Monthly Timetable</span>
      </button>
      <button class="nav-tab px-4 py-2.5 rounded-t-xl text-sm font-semibold flex items-center gap-2 border-b-2 border-transparent text-stone-500 dark:text-stone-400 hover:text-stone-800 dark:hover:text-stone-200 hover:bg-stone-200/40 dark:hover:bg-emerald-900/30 transition" data-target="tab-tasbih">
        <i class="fa-solid fa-ring"></i> <span>Digital Tasbih</span>
      </button>
    </nav>
  </div>

  <!-- Main Content Body -->
  <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- ==================== TAB 1: PRAYER TIMES & DASHBOARD ==================== -->
    <section id="tab-prayers" class="tab-content space-y-6">
      
      <!-- HERO COUNTDOWN & CLOCK BANNER -->
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-emerald-900 via-emerald-850 to-emerald-950 text-white p-6 sm:p-8 lg:p-10 border border-gold-500/30 shadow-2xl">
        <!-- Islamic Arch & Star Watermark Background -->
        <div class="absolute -right-16 -top-16 opacity-10 pointer-events-none">
          <i class="fa-solid fa-kaaba text-[280px] text-gold-400"></i>
        </div>

        <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <!-- Left: Current Time & Hijri Date -->
          <div class="lg:col-span-5 space-y-3 text-center lg:text-left">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gold-500/20 border border-gold-500/40 text-gold-300 text-xs font-medium">
              <span class="w-2 h-2 rounded-full bg-gold-400 animate-ping"></span>
              <span id="hero-hijri-date">1448 Hijri</span>
            </div>
            
            <h1 id="live-time-clock" class="text-5xl sm:text-6xl font-extrabold tracking-tight font-mono text-stone-100">
              00:00:00
            </h1>
            
            <p id="hero-gregorian-date" class="text-sm sm:text-base text-stone-300 font-medium">
              Loading current date...
            </p>
            
            <div class="flex items-center justify-center lg:justify-start gap-2 text-xs text-stone-400">
              <i class="fa-solid fa-map-pin text-gold-400"></i>
              <span id="hero-coords-display">Calculating coordinates...</span>
            </div>
          </div>

          <!-- Right: Next Prayer Countdown Card -->
          <div class="lg:col-span-7 bg-emerald-950/60 backdrop-blur-md rounded-2xl p-5 sm:p-6 border border-gold-500/20">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pb-4 border-b border-emerald-800/60">
              <div>
                <span class="text-xs uppercase tracking-wider text-gold-400 font-semibold block text-center sm:text-left">Upcoming Prayer</span>
                <div class="flex items-baseline gap-2 justify-center sm:justify-start">
                  <h2 id="next-prayer-name" class="text-3xl font-bold text-white tracking-wide">--</h2>
                  <span id="next-prayer-time" class="text-lg text-gold-300 font-mono font-medium">--:--</span>
                </div>
              </div>
              <!-- Countdown Display -->
              <div class="text-center sm:text-right">
                <span class="text-xs text-stone-400 font-medium block">Time Remaining</span>
                <div id="countdown-timer" class="text-3xl sm:text-4xl font-mono font-bold text-gold-400">
                  00h 00m 00s
                </div>
              </div>
            </div>

            <!-- Progress Bar to Next Prayer -->
            <div class="mt-4 space-y-1.5">
              <div class="flex justify-between text-xs text-stone-300">
                <span id="progress-prev-prayer">Current</span>
                <span id="progress-percent">0%</span>
                <span id="progress-next-prayer">Next</span>
              </div>
              <div class="w-full bg-emerald-900/80 rounded-full h-2.5 overflow-hidden border border-emerald-700/50">
                <div id="prayer-progress-bar" class="bg-gradient-to-r from-gold-600 via-gold-400 to-amber-300 h-2.5 rounded-full transition-all duration-500" style="width: 25%"></div>
              </div>
            </div>

            <div class="mt-4 flex items-center justify-between text-xs text-stone-300">
              <div class="flex items-center gap-1.5">
                <i class="fa-solid fa-compass text-gold-400"></i>
                <span>Qibla: <strong id="hero-qibla-angle" class="text-gold-300">--°</strong></span>
              </div>
              <div class="flex items-center gap-1.5">
                <button id="btn-quick-adhan-sample" class="px-2.5 py-1 rounded bg-gold-500/20 hover:bg-gold-500/30 text-gold-300 border border-gold-500/30 flex items-center gap-1.5 transition">
                  <i class="fa-solid fa-bell"></i> <span>Play Chime</span>
                </button>
              </div>
            </div>

          </div>

        </div>
      </div>

      <!-- PRAYER TIME CARDS GRID -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5 sm:gap-4" id="prayer-cards-container">
        <!-- Dynamically Populated with Fajr, Sunrise, Dhuhr, Asr, Maghrib, Isha -->
      </div>

      <!-- DUAL INSPIRATIONAL & BENEFIT ROW: AYAT & HADITH -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Daily Ayat / Dua Card -->
        <div class="rounded-2xl p-6 bg-white dark:bg-emerald-900/40 border border-stone-200 dark:border-emerald-800/80 shadow-sm relative overflow-hidden flex flex-col justify-between">
          <div class="absolute top-0 right-0 transform translate-x-4 -translate-y-4 opacity-5 dark:opacity-10 text-stone-900 dark:text-gold-400 pointer-events-none text-9xl">
            <i class="fa-solid fa-quran"></i>
          </div>
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-gold-600 dark:text-gold-400 bg-gold-500/10 px-3 py-1 rounded-full border border-gold-500/20">
                <i class="fa-solid fa-book-quran"></i> Ayat / Remembrance
              </span>
              <button id="refresh-ayat-btn" title="Refresh Ayat" class="text-xs text-stone-400 hover:text-gold-500 transition p-1">
                <i class="fa-solid fa-rotate-right"></i>
              </button>
            </div>
            <!-- Arabic Script -->
            <p id="daily-ayat-arabic" class="font-arabic text-right text-xl sm:text-2xl leading-relaxed text-stone-900 dark:text-gold-300 mb-3 font-semibold" dir="rtl">
              رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ
            </p>
            <!-- Translation -->
            <p id="daily-ayat-translation" class="text-sm text-stone-600 dark:text-stone-300 italic mb-2">
              "Our Lord, give us in this world that which is good and in the Hereafter that which is good and protect us from the punishment of the Fire."
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-stone-200 dark:border-emerald-800/60 flex items-center justify-between text-xs text-stone-400">
            <span id="daily-ayat-ref" class="font-semibold text-stone-500 dark:text-stone-400">Surah Al-Baqarah 2:201</span>
            <button id="copy-ayat-btn" class="hover:text-gold-400 flex items-center gap-1 transition">
              <i class="fa-regular fa-copy"></i> Copy
            </button>
          </div>
        </div>

        <!-- Prayer Information & Jurisprudence Summary -->
        <div class="rounded-2xl p-6 bg-white dark:bg-emerald-900/40 border border-stone-200 dark:border-emerald-800/80 shadow-sm flex flex-col justify-between">
          <div>
            <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-emerald-700 dark:text-emerald-300 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20 mb-4">
              <i class="fa-solid fa-circle-check"></i> Calculation Details
            </span>
            <div class="space-y-3 text-sm">
              <div class="flex items-center justify-between pb-2 border-b border-stone-100 dark:border-emerald-800/50">
                <span class="text-stone-500 dark:text-stone-400">Calculation Method</span>
                <span id="summary-method-name" class="font-semibold text-stone-800 dark:text-stone-200">Muslim World League</span>
              </div>
              <div class="flex items-center justify-between pb-2 border-b border-stone-100 dark:border-emerald-800/50">
                <span class="text-stone-500 dark:text-stone-400">Asr Juristic Rule</span>
                <span id="summary-asr-method" class="font-semibold text-stone-800 dark:text-stone-200">Standard (Shafi'i, Maliki, Hanbali)</span>
              </div>
              <div class="flex items-center justify-between pb-2 border-b border-stone-100 dark:border-emerald-800/50">
                <span class="text-stone-500 dark:text-stone-400">Distance to Kaaba</span>
                <span id="summary-kaaba-dist" class="font-mono font-semibold text-gold-600 dark:text-gold-400">-- km</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-stone-500 dark:text-stone-400">High Latitude Rule</span>
                <span class="font-semibold text-stone-800 dark:text-stone-200">Angle-Based (1/7th Night)</span>
              </div>
            </div>
          </div>
          <div class="mt-4 pt-3 border-t border-stone-200 dark:border-emerald-800/60 flex items-center justify-between text-xs">
            <span class="text-stone-400">Need specific adjustments?</span>
            <button onclick="document.getElementById('settings-modal-btn').click()" class="text-gold-600 dark:text-gold-400 font-semibold hover:underline">
              Customize Settings &rarr;
            </button>
          </div>
        </div>

      </div>

    </section>

    <!-- ==================== TAB 2: INTERACTIVE QIBLA FINDER ==================== -->
    <section id="tab-qibla" class="tab-content hidden space-y-6">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Left: Interactive Dial & Compass Visualizer -->
        <div class="lg:col-span-7 flex flex-col items-center justify-center p-6 sm:p-10 bg-white dark:bg-emerald-900/40 rounded-3xl border border-stone-200 dark:border-emerald-800/80 shadow-xl">
          
          <div class="relative w-72 h-72 sm:w-96 sm:h-96 flex items-center justify-center select-none">
            
            <!-- Outer Compass Ring (Degree ticks) -->
            <div id="compass-outer" class="compass-dial absolute inset-0 rounded-full border-4 border-dashed border-stone-300 dark:border-emerald-700/60 flex items-center justify-center shadow-inner">
              <!-- Cardinal Points -->
              <span class="absolute top-2 font-bold text-red-500 dark:text-red-400 text-sm tracking-wider">N</span>
              <span class="absolute right-3 font-bold text-stone-500 dark:text-stone-400 text-sm">E</span>
              <span class="absolute bottom-2 font-bold text-stone-500 dark:text-stone-400 text-sm">S</span>
              <span class="absolute left-3 font-bold text-stone-500 dark:text-stone-400 text-sm">W</span>
              
              <!-- Inner Graduated Circles -->
              <div class="w-5/6 h-5/6 rounded-full border border-stone-200 dark:border-emerald-800/70 flex items-center justify-center">
                <div class="w-4/6 h-4/6 rounded-full border border-gold-500/20"></div>
              </div>
            </div>

            <!-- Kaaba Target Pointer (Fixed bearing relative to North) -->
            <div id="kaaba-pointer-container" class="absolute inset-0 flex items-center justify-center transition-transform duration-300 pointer-events-none">
              <div class="w-full h-full relative flex items-center justify-center">
                <!-- Kaaba Marker at bearing tip -->
                <div class="absolute -top-3 flex flex-col items-center">
                  <div class="w-8 h-8 rounded-lg bg-emerald-900 border-2 border-gold-400 flex items-center justify-center shadow-lg transform rotate-0 text-gold-300">
                    <i class="fa-solid fa-kaaba text-base"></i>
                  </div>
                  <span class="text-[10px] font-bold uppercase tracking-wider text-gold-500 bg-emerald-950 px-1.5 py-0.5 rounded shadow mt-1">Qibla</span>
                </div>
                <!-- Needle line connecting center to Kaaba -->
                <div class="w-0.5 h-1/2 bg-gradient-to-t from-transparent via-gold-500 to-gold-400 absolute top-0"></div>
              </div>
            </div>

            <!-- Compass Needle (North-South pointer) -->
            <div id="compass-needle" class="compass-dial absolute inset-0 flex items-center justify-center pointer-events-none">
              <!-- Magnetic North Arrow (Red) -->
              <div class="w-3 h-28 sm:h-36 bg-gradient-to-t from-red-600 to-red-400 rounded-t-full shadow-md absolute -top-2"></div>
              <!-- Magnetic South Arrow (White/Gray) -->
              <div class="w-3 h-28 sm:h-36 bg-gradient-to-b from-stone-400 to-stone-200 dark:from-stone-600 dark:to-stone-400 rounded-b-full shadow-md absolute -bottom-2"></div>
              <!-- Center Pivot Pin -->
              <div class="w-7 h-7 rounded-full bg-gold-500 border-2 border-white dark:border-emerald-950 shadow-lg z-20 flex items-center justify-center">
                <div class="w-2.5 h-2.5 rounded-full bg-emerald-950"></div>
              </div>
            </div>

          </div>

          <!-- Compass Manual Rotate Slider (For Desktop testing & calibration) -->
          <div class="w-full max-w-sm mt-8 space-y-2">
            <div class="flex justify-between text-xs text-stone-500 dark:text-stone-400 font-medium">
              <span>Manual Heading Adjust (Desktop / Simulation)</span>
              <span id="manual-heading-val">0° (North)</span>
            </div>
            <input id="heading-slider" type="range" min="0" max="360" value="0" class="w-full h-2 bg-stone-200 dark:bg-emerald-800 rounded-lg appearance-none cursor-pointer accent-gold-500">
          </div>

          <!-- Mobile Device Orientation Sensor Button -->
          <div class="mt-4 flex gap-3">
            <button id="btn-calibrate-compass" class="px-4 py-2.5 rounded-xl bg-gold-500 text-emerald-950 font-bold text-sm shadow hover:bg-gold-400 active:scale-95 transition flex items-center gap-2">
              <i class="fa-solid fa-mobile-screen"></i> <span>Calibrate / Device Compass</span>
            </button>
            <button id="btn-reset-heading" class="px-4 py-2.5 rounded-xl bg-stone-200 dark:bg-emerald-800 text-stone-800 dark:text-stone-200 font-medium text-sm hover:bg-stone-300 dark:hover:bg-emerald-700 transition">
              Reset North
            </button>
          </div>

          <p class="text-xs text-stone-500 dark:text-stone-400 text-center mt-3 max-w-xs">
            Align the needle with the <span class="text-gold-500 font-semibold">Kaaba icon</span>. On mobile, hold device flat horizontally away from magnetic interference.
          </p>

        </div>

        <!-- Right: Exact Qibla Trigonometry Telemetry & Kaaba Details -->
        <div class="lg:col-span-5 space-y-6">
          
          <div class="bg-white dark:bg-emerald-900/40 rounded-3xl p-6 sm:p-8 border border-stone-200 dark:border-emerald-800/80 shadow-md">
            <div class="flex items-center gap-2 text-gold-500 text-sm font-bold uppercase tracking-wider mb-2">
              <i class="fa-solid fa-location-crosshairs"></i> Precise Bearing
            </div>
            
            <div class="flex items-baseline gap-3">
              <span id="qibla-angle-big" class="text-5xl font-extrabold text-stone-900 dark:text-stone-100 font-mono">0.0°</span>
              <span id="qibla-cardinal-str" class="text-lg font-semibold text-stone-500 dark:text-stone-400">from North</span>
