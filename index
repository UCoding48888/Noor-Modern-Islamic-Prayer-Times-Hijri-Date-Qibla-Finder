    // ==========================================
    // ASTRONOMICAL PRAYER CALCULATION ALGORITHM
    // Standard spherical astronomy formulas
    // ==========================================
    
    // Math degree conversions
    const d2r = (d) => (d * Math.PI) / 180.0;
    const r2d = (r) => (r * 180.0) / Math.PI;
    const sinD = (d) => Math.sin(d2r(d));
    const cosD = (d) => Math.cos(d2r(d));
    const tanD = (d) => Math.tan(d2r(d));
    const asinD = (x) => r2d(Math.asin(x));
    const acosD = (x) => r2d(Math.acos(x));
    const atan2D = (y, x) => r2d(Math.atan2(y, x));

    // Normalize hours to 0..24
    function fixHour(h) {
      h = h - 24.0 * Math.floor(h / 24.0);
      return h < 0 ? h + 24.0 : h;
    }

    // Normalize degrees to 0..360
    function fixAngle(a) {
      a = a - 360.0 * Math.floor(a / 360.0);
      return a < 0 ? a + 360.0 : a;
    }

    // Solar Position Calculation for a given Julian Day
    function sunPosition(julianDate) {
      const D = julianDate - 2451545.0;
      const g = fixAngle(357.529 + 0.98560028 * D);
      const q = fixAngle(280.459 + 0.98564736 * D);
      const L = fixAngle(q + 1.915 * sinD(g) + 0.020 * sinD(2 * g));
      
      const e = 23.439 - 0.00000036 * D;
      const d = asinD(sinD(e) * sinD(L));
      let ra = atan2D(cosD(e) * sinD(L), cosD(L)) / 15.0;
      ra = fixHour(ra);
      
      const EqT = q / 15.0 - ra;
      return { declination: d, equationOfTime: EqT };
    }

    function getJulianDate(year, month, day) {
      if (month <= 2) {
        year -= 1;
        month += 12;
      }
      const A = Math.floor(year / 100);
      const B = 2 - A + Math.floor(A / 4);
      return Math.floor(365.25 * (year + 4716)) + Math.floor(30.6001 * (month + 1)) + day + B - 1524.5;
    }

    // Calculate prayer times for a specified date
    function calculatePrayerTimesForDate(date, lat, lng, methodCode, asrSchool) {
      const year = date.getFullYear();
      const month = date.getMonth() + 1;
      const day = date.getDate();
      const timezoneOffset = -date.getTimezoneOffset() / 60; // hours from UTC

      const JDate = getJulianDate(year, month, day);
      const sun = sunPosition(JDate);
      const method = METHOD_PARAMS[methodCode] || METHOD_PARAMS.MWL;

      // Solar Noon (Dhuhr)
      const noon = fixHour(12 + timezoneOffset - lng / 15.0 - sun.equationOfTime);

      // Sun Angle T-hour helper
      function timeForAngle(angle, isMorning = false) {
        const val = (-sinD(angle) - sinD(lat) * sinD(sun.declination)) / (cosD(lat) * cosD(sun.declination));
        if (val > 1 || val < -1) return null; // Extreme latitudes edge
        const hourAngle = acosD(val) / 15.0;
        return isMorning ? noon - hourAngle : noon + hourAngle;
      }

      // Asr shadow length factor (1 for standard, 2 for hanafi)
      const shadowFactor = asrSchool === 'hanafi' ? 2 : 1;
      const asrAngleVal = atan2D(1, shadowFactor + tanD(Math.abs(lat - sun.declination)));
      const asrTime = noon + (acosD((sinD(asrAngleVal) - sinD(lat) * sinD(sun.declination)) / (cosD(lat) * cosD(sun.declination))) / 15.0);

      // Sunrise & Sunset (approx angle 0.833° for refraction & solar radius)
      const sunrise = timeForAngle(0.833, true);
      const sunset = timeForAngle(0.833, false);

      // Fajr
      let fajr = timeForAngle(method.fajrAngle, true);
      if (fajr === null && sunrise !== null) {
        // High latitude fallback: 1/7th of night before sunrise
        fajr = sunrise - 1.5;
      }

      // Isha
      let isha;
      if (method.ishaInterval) {
        // Umm Al-Qura uses fixed interval after sunset
        isha = sunset + (method.ishaInterval / 60.0);
      } else {
        isha = timeForAngle(method.ishaAngle, false);
        if (isha === null && sunset !== null) {
          isha = sunset + 1.5;
        }
      }

      // Apply minute manual offsets
      const fajrDate = floatHourToDate(date, fajr + (state.offsetFajr / 60));
      const sunriseDate = floatHourToDate(date, sunrise);
      const dhuhrDate = floatHourToDate(date, noon);
      const asrDate = floatHourToDate(date, asrTime);
      const maghribDate = floatHourToDate(date, sunset + (state.offsetMaghrib / 60));
      const ishaDate = floatHourToDate(date, isha);

      return [
        { id: 'fajr', name: 'Fajr', arabic: 'الفجر', date: fajrDate, icon: 'fa-cloud-sun' },
        { id: 'sunrise', name: 'Sunrise', arabic: 'الشروق', date: sunriseDate, icon: 'fa-sun', isSunrise: true },
        { id: 'dhuhr', name: 'Dhuhr', arabic: 'الظهر', date: dhuhrDate, icon: 'fa-sun' },
        { id: 'asr', name: 'Asr', arabic: 'العصر', date: asrDate, icon: 'fa-mountain-sun' },
        { id: 'maghrib', name: 'Maghrib', arabic: 'المغرب', date: maghribDate, icon: 'fa-cloud-meatball' },
        { id: 'isha', name: 'Isha', arabic: 'العشاء', date: ishaDate, icon: 'fa-moon' }
      ];
    }

    function floatHourToDate(baseDate, floatHour) {
      if (floatHour == null || isNaN(floatHour)) floatHour = 12;
      floatHour = fixHour(floatHour);
      const hours = Math.floor(floatHour);
      const remainderMinutes = (floatHour - hours) * 60;
      const minutes = Math.floor(remainderMinutes);
      const seconds = Math.floor((remainderMinutes - minutes) * 60);

      const d = new Date(baseDate.getTime());
      d.setHours(hours, minutes, seconds, 0);
      return d;
    }

    // Format Date object into 12h or 24h string
    function formatTimeString(dateObj, format = state.timeFormat) {
      if (!dateObj || isNaN(dateObj.getTime())) return "--:--";
      let h = dateObj.getHours();
      const m = String(dateObj.getMinutes()).padStart(2, '0');
      
      if (format === '24h') {
        return `${String(h).padStart(2, '0')}:${m}`;
      } else {
        const ampm = h >= 12 ? 'PM' : 'AM';
        h = h % 12;
        h = h ? h : 12; // 0 hour is 12
        return `${h}:${m} ${ampm}`;
      }
    }

    // ==========================================
    // SPHERICAL TRIGONOMETRY FOR QIBLA & DISTANCE
    // ==========================================
    function calculateQibla(lat1, lon1) {
      const lat2 = KAABA_COORDS.lat;
      const lon2 = KAABA_COORDS.lng;

      // Great-circle initial bearing
      const phi1 = d2r(lat1);
      const phi2 = d2r(lat2);
      const deltaLambda = d2r(lon2 - lon1);

      const y = Math.sin(deltaLambda);
      const x = Math.cos(phi1) * Math.tan(phi2) - Math.sin(phi1) * Math.cos(deltaLambda);
      
      let bearing = r2d(Math.atan2(y, x));
      bearing = (bearing + 360) % 360; // Normalize 0..360

      // Great-circle Haversine distance
      const R = 6371; // Earth radius in km
      const dLat = d2r(lat2 - lat1);
      const dLon = d2r(lon2 - lon1);
      const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(phi1) * Math.cos(phi2) *
                Math.sin(dLon / 2) * Math.sin(dLon / 2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      const distanceKm = R * c;
      const distanceMiles = distanceKm * 0.621371;

      return {
        bearing: bearing,
        distanceKm: Math.round(distanceKm),
        distanceMiles: Math.round(distanceMiles)
      };
    }

    // ==========================================
    // ISLAMIC HIJRI DATE CONVERSION (Umm Al-Qura / Tabular)
    // ==========================================
    function getHijriDate(date) {
      // Intl format support with fallback
      try {
        const hijriFormatter = new Intl.DateTimeFormat('en-u-ca-islamic-umalqura', {
          day: 'numeric',
          month: 'long',
          year: 'numeric'
        });
        return hijriFormatter.format(date);
      } catch (e) {
        // Fallback approximation
        return "1448 Hijri";
      }
    }

    // ==========================================
    // AUDIO SYNTHESIS / NOTIFICATION CHIME
    // Pure Web Audio API chime (Zero external audio assets)
    // ==========================================
    let audioCtx = null;
    function playAdhanNotificationChime() {
      if (!state.audioEnabled) return;
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!audioCtx) {
          audioCtx = new AudioContext();
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }

        // Play gentle multi-tone spiritual bell chord (Fajr chime)
        const notes = [440, 554.37, 659.25, 880]; // A4 Major chord
        notes.forEach((freq, idx) => {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();

          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, audioCtx.currentTime + idx * 0.15);

          gain.gain.setValueAtTime(0, audioCtx.currentTime);
          gain.gain.linearRampToValueAtTime(0.2 / (idx + 1), audioCtx.currentTime + idx * 0.15 + 0.05);
          gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + idx * 0.15 + 2.5);

          osc.connect(gain);
          gain.connect(audioCtx.destination);

          osc.start(audioCtx.currentTime + idx * 0.15);
          osc.stop(audioCtx.currentTime + idx * 0.15 + 2.6);
        });
        
        showToast("Adhan prayer alert chime played", "fa-bell");
      } catch (err) {
        console.error("Audio synthesis notice:", err);
      }
    }

    // ==========================================
    // UI TOAST SYSTEM (Replacement for alert)
    // ==========================================
    function showToast(message, icon = "fa-circle-info") {
      const toast = document.getElementById('toast');
      const msgEl = document.getElementById('toast-message');
      const iconEl = document.getElementById('toast-icon');

      msgEl.textContent = message;
      iconEl.innerHTML = `<i class="fa-solid ${icon}"></i>`;

      toast.classList.remove('opacity-0', 'translate-y-[-120%]', 'pointer-events-none');
      toast.classList.add('opacity-100', 'translate-y-0');

      clearTimeout(toast._timeout);
      toast._timeout = setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', 'translate-y-[-120%]', 'pointer-events-none');
      }, 3500);
    }

    // ==========================================
    // CORE RENDER & UPDATE FUNCTIONS
    // ==========================================
    
    // Refresh calculations and UI elements
    function updateAll() {
      const now = new Date();

      // Update dates & live clock
      document.getElementById('live-time-clock').textContent = now.toTimeString().split(' ')[0];
      
      const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      document.getElementById('hero-gregorian-date').textContent = now.toLocaleDateString('en-US', options);
      document.getElementById('hero-hijri-date').textContent = getHijriDate(now);

      // Hero coordinates & location
      document.getElementById('current-location-text').textContent = state.locationName;
      document.getElementById('hero-coords-display').textContent = `${state.lat.toFixed(4)}° N, ${state.lng.toFixed(4)}° E &bull; ${state.locationName}`;

      // Calculate today's prayer times
      const todayTimes = calculatePrayerTimesForDate(now, state.lat, state.lng, state.method, state.asrSchool);
      state.currentPrayerTimes = todayTimes;

      // Also calculate tomorrow's Fajr for overnight countdown
      const tomorrow = new Date(now.getTime() + 86400000);
      const tomorrowTimes = calculatePrayerTimesForDate(tomorrow, state.lat, state.lng, state.method, state.asrSchool);
      const tomorrowFajr = tomorrowTimes[0];

      // Determine active and next prayer
      let activeIndex = -1;
      let nextIndex = -1;

      for (let i = 0; i < todayTimes.length; i++) {
        if (now >= todayTimes[i].date) {
          activeIndex = i;
        } else {
          if (nextIndex === -1) nextIndex = i;
        }
      }

      let nextPrayerObj = null;
      let prevPrayerObj = null;

      if (nextIndex !== -1) {
        nextPrayerObj = todayTimes[nextIndex];
        prevPrayerObj = activeIndex >= 0 ? todayTimes[activeIndex] : null;
      } else {
        // After Isha, next prayer is tomorrow's Fajr
        nextIndex = 0;
        nextPrayerObj = tomorrowFajr;
        prevPrayerObj = todayTimes[todayTimes.length - 1]; // Isha
      }

      state.activePrayerIndex = activeIndex;
      state.nextPrayerIndex = nextIndex;

      // Update Countdown to Next Prayer
      const diffMs = nextPrayerObj.date.getTime() - now.getTime();
      if (diffMs > 0) {
        const diffHrs = Math.floor(diffMs / (1000 * 60 * 60));
        const diffMins = Math.floor((diffMs % (1000 * 60 * 60)) / (1000 * 60));
        const diffSecs = Math.floor((diffMs % (1000 * 60)) / 1000);

        document.getElementById('countdown-timer').textContent = 
          `${String(diffHrs).padStart(2, '0')}h ${String(diffMins).padStart(2, '0')}m ${String(diffSecs).padStart(2, '0')}s`;
        
        // Progress bar between previous and next prayer
        if (prevPrayerObj) {
          const totalWindow = nextPrayerObj.date.getTime() - prevPrayerObj.date.getTime();
          const elapsed = now.getTime() - prevPrayerObj.date.getTime();
          const percent = Math.min(100, Math.max(0, Math.round((elapsed / totalWindow) * 100)));
          document.getElementById('prayer-progress-bar').style.width = `${percent}%`;
          document.getElementById('progress-percent').textContent = `${percent}%`;
          document.getElementById('progress-prev-prayer').textContent = prevPrayerObj.name;
          document.getElementById('progress-next-prayer').textContent = nextPrayerObj.name;
        }
      }

      document.getElementById('next-prayer-name').textContent = nextPrayerObj.name;
      document.getElementById('next-prayer-time').textContent = formatTimeString(nextPrayerObj.date);

      // Render Prayer Cards
      renderPrayerCards(todayTimes, activeIndex, nextIndex);

      // Update Qibla Bearing Telemetry
      const qiblaData = calculateQibla(state.lat, state.lng);
      document.getElementById('hero-qibla-angle').textContent = `${qiblaData.bearing.toFixed(1)}°`;
      document.getElementById('qibla-angle-big').textContent = `${qiblaData.bearing.toFixed(1)}°`;
      document.getElementById('qibla-km-dist').textContent = `${qiblaData.distanceKm.toLocaleString()} km`;
      document.getElementById('qibla-miles-dist').textContent = `${qiblaData.distanceMiles.toLocaleString()} mi`;
      document.getElementById('summary-kaaba-dist').textContent = `${qiblaData.distanceKm.toLocaleString()} km`;
      document.getElementById('qibla-current-coords').textContent = `${state.lat.toFixed(3)}°, ${state.lng.toFixed(3)}°`;

      // Update Qibla Compass Needle visuals
      updateCompassVisual(qiblaData.bearing);

      // Calculation Summary Texts
      document.getElementById('summary-method-name').textContent = METHOD_PARAMS[state.method]?.name || state.method;
      document.getElementById('summary-asr-method').textContent = state.asrSchool === 'hanafi' ? "Hanafi (2x Shadow)" : "Standard (Shafi'i/Maliki/Hanbali)";
    }

    // Render individual prayer cards
    function renderPrayerCards(prayers, activeIdx, nextIdx) {
      const container = document.getElementById('prayer-cards-container');
      container.innerHTML = '';

      prayers.forEach((prayer, idx) => {
        const isNext = (nextIdx === idx && (!prayer.isSunrise));
        const isActive = (activeIdx === idx);

        let borderClass = 'border-stone-200 dark:border-emerald-800/80';
        let bgClass = 'bg-white dark:bg-emerald-900/40';
        let badgeHtml = '';

        if (isNext) {
          borderClass = 'border-gold-500 shadow-lg gold-glow';
          bgClass = 'bg-gold-500/10 dark:bg-emerald-900/90';
          badgeHtml = `<span class="absolute top-2.5 right-2.5 text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-gold-500 text-emerald-950">Next</span>`;
        } else if (isActive) {
          borderClass = 'border-emerald-500/60';
          bgClass = 'bg-emerald-500/5 dark:bg-emerald-900/60';
          badgeHtml = `<span class="absolute top-2.5 right-2.5 text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-300">Active</span>`;
        }

        const card = document.createElement('div');
        card.className = `relative p-4 sm:p-5 rounded-2xl border transition-all duration-300 ${borderClass} ${bgClass} flex flex-col justify-between`;

        card.innerHTML = `
          ${badgeHtml}
          <div class="flex items-center gap-2 mb-3">
            <div class="w-8 h-8 rounded-xl ${isNext ? 'bg-gold-500 text-emerald-950' : 'bg-stone-100 dark:bg-emerald-800 text-gold-500'} flex items-center justify-center text-sm shadow-sm">
              <i class="fa-solid ${prayer.icon}"></i>
            </div>
            <div>
              <h3 class="text-sm font-bold text-stone-800 dark:text-stone-100">${prayer.name}</h3>
              <span class="text-xs font-arabic text-stone-500 dark:text-stone-400 font-semibold">${prayer.arabic}</span>
            </div>
          </div>
          
          <div class="mt-2">
            <span class="text-xl sm:text-2xl font-mono font-bold ${isNext ? 'text-gold-600 dark:text-gold-400' : 'text-stone-800 dark:text-stone-200'}">
              ${formatTimeString(prayer.date)}
            </span>
          </div>
        `;

        container.appendChild(card);
      });
    }

    // ==========================================
    // COMPASS ROTATION LOGIC
    // ==========================================
    function updateCompassVisual(qiblaBearing) {
      const heading = state.currentHeading; // Device heading in degrees from North
      
      // Dial rotates counter to user heading
      const compassOuter = document.getElementById('compass-outer');
      const compassNeedle = document.getElementById('compass-needle');
      const kaabaPointer = document.getElementById('kaaba-pointer-container');

      if (compassOuter && compassNeedle && kaabaPointer) {
        // Needle always indicates North-South relative to heading
        compassNeedle.style.transform = `rotate(${-heading}deg)`;
        compassOuter.style.transform = `rotate(${-heading}deg)`;

        // Kaaba pointer points at the bearing offset by heading
        const kaabaRelativeRotation = qiblaBearing - heading;
        kaabaPointer.style.transform = `rotate(${kaabaRelativeRotation}deg)`;
      }
    }

    // ==========================================
    // MONTHLY TIMETABLE GENERATION
    // ==========================================
    function renderMonthlyTimetable(offsetMonths = 0) {
      const targetDate = new Date();
      targetDate.setMonth(targetDate.getMonth() + offsetMonths);

      const year = targetDate.getFullYear();
      const month = targetDate.getMonth();
      const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

      document.getElementById('timetable-title-month').textContent = `${monthNames[month]} ${year}`;
      document.getElementById('timetable-badge-year').textContent = `${year} CE`;

      const tbody = document.getElementById('monthly-table-body');
      tbody.innerHTML = '';

      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const today = new Date();

      for (let day = 1; day <= daysInMonth; day++) {
        const currentDate = new Date(year, month, day);
        const times = calculatePrayerTimesForDate(currentDate, state.lat, state.lng, state.method, state.asrSchool);

        const isCurrentDay = (
          today.getDate() === day &&
          today.getMonth() === month &&
          today.getFullYear() === year
        );

        const tr = document.createElement('tr');
        tr.className = isCurrentDay 
          ? 'bg-gold-500/15 font-semibold text-gold-600 dark:text-gold-300 border-l-4 border-gold-500' 
          : 'hover:bg-stone-50 dark:hover:bg-emerald-800/30 text-stone-700 dark:text-stone-300';

        const dayName = currentDate.toLocaleDateString('en-US', { weekday: 'short' });

        tr.innerHTML = `
          <td class="py-3 px-3 font-sans font-medium">
            <span class="inline-block w-6 text-stone-400 font-mono">${day}</span>
            <span>${dayName}</span>
            ${isCurrentDay ? '<span class="ml-1 text-[10px] bg-gold-500 text-emerald-950 px-1.5 py-0.5 rounded font-bold uppercase no-print">Today</span>' : ''}
          </td>
          <td class="py-3 px-3">${formatTimeString(times[0].date)}</td>
          <td class="py-3 px-3 text-stone-500 dark:text-stone-400">${formatTimeString(times[1].date)}</td>
          <td class="py-3 px-3">${formatTimeString(times[2].date)}</td>
          <td class="py-3 px-3">${formatTimeString(times[3].date)}</td>
          <td class="py-3 px-3">${formatTimeString(times[4].date)}</td>
          <td class="py-3 px-3">${formatTimeString(times[5].date)}</td>
        `;

        tbody.appendChild(tr);
      }
    }

    // ==========================================
    // DIGITAL TASBIH LOGIC & FEEDBACK
    // ==========================================
    function incrementTasbih() {
      state.tasbihCount++;
      state.tasbihTotal++;

      // Trigger soft vibration on supported mobile devices
      if ("vibrate" in navigator) {
        navigator.vibrate(25);
      }

      // Check if target cycle reached
      if (state.tasbihCount >= state.tasbihTarget) {
        state.tasbihCycles++;
        state.tasbihCount = 0;
        showToast(`Target of ${state.tasbihTarget} completed! Cycle recorded.`, 'fa-circle-check');
        if ("vibrate" in navigator) {
          navigator.vibrate([60, 50, 60]);
        }
      }

      updateTasbihUI();
    }

    function updateTasbihUI() {
      document.getElementById('tasbih-number-display').textContent = state.tasbihCount;
      document.getElementById('tasbih-target-num').textContent = state.tasbihTarget;
      document.getElementById('tasbih-cycles-count').textContent = state.tasbihCycles;
      document.getElementById('tasbih-total-count').textContent = state.tasbihTotal;
    }

